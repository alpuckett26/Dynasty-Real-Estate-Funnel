# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── HubSpot ──────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-na1-...
HUBSPOT_PORTAL_ID=
HUBSPOT_PIPELINE_ID=default

# ─── Calendly ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-team/consultation

# ─── Meta Pixel ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Google Analytics / Ads ───────────────────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX

# ─── CallRail ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALLRAIL_ACCOUNT_ID=

# ─── ManyChat ─────────────────────────────────────────────────────────────────
MANYCHAT_API_KEY=

# ─── FRED API (mortgage rates) ────────────────────────────────────────────────
# Free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ─── Twilio SMS ───────────────────────────────────────────────────────────────
# Account SID and Auth Token from console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Your Twilio phone number in E.164 format
TWILIO_FROM_NUMBER=+12255551234
# Owner's mobile number for hot lead SMS alerts (E.164 format)
OWNER_PHONE=+12255554321

# ─── Resend Email ─────────────────────────────────────────────────────────────
# API key from resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender domain — must match a domain verified in Resend
FROM_EMAIL=hello@adreannetherealtor.com
REPLY_TO_EMAIL=adreanne@adreannetherealtor.com

# ─── Meta Lead Ads (Facebook/Instagram) ───────────────────────────────────────
# Real-time lead delivery from FB/IG lead-form ads → /api/webhooks/meta
# 1. developers.facebook.com → your app → Webhooks → Page → subscribe "leadgen"
# 2. Verify token: any string you choose — must match here and in the Meta dialog
# 3. Page access token with leads_retrieval + pages_manage_metadata permissions
META_VERIFY_TOKEN=choose-any-random-string
META_APP_SECRET=your_meta_app_secret
META_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxx

# ─── Daily Lead Digest ────────────────────────────────────────────────────────
# Where the 6pm daily lead summary email goes. Falls back to REPLY_TO_EMAIL.
DIGEST_EMAIL=adreanne@adreannetherealtor.com

# ─── Slack Notifications ──────────────────────────────────────────────────────
# Hot lead alerts. Get your webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── Webhook Security ─────────────────────────────────────────────────────────
WEBHOOK_SECRET=your-strong-secret-here
# Cron job auth token — set in Vercel and must match x-cron-secret header
CRON_SECRET=your-cron-secret-here

# ─── Local testing safety switch ──────────────────────────────────────────────
# `next dev` and `next start` both load .env.local, so running a cron or lead
# route locally sends REAL texts and emails to REAL people using the live
# credentials above. Set this to true in .env.local before testing anything that
# sends; every SMS, email and Slack post becomes a logged no-op instead.
# Leave it UNSET in Vercel.
OUTBOUND_DISABLED=

# ─── Lead-gen scraper sources ─────────────────────────────────────────────────
# All three free scraper sources are OFF by default — each was verified
# unusable on 2026-08-15 (see src/lib/lead-gen/source-health.ts for evidence).
# Purchased lists via /api/lead-gen/import (REDX) are the working path.
#
# Set one to "true" to re-enable it. The daily lead-gen cron alerts Adreanne if
# an enabled source is blocked, so a dead source can't quietly look like a slow
# day again. Leave these unset unless you're actively retesting a source.
#   reddit-monitor   HTTP 403 everywhere; would need a registered OAuth app
#   craigslist-fsbo  HTTP 403 from cloud and residential IPs alike
#   city-data        reachable, but its forum filter is ignored server-side
LEADGEN_ENABLE_REDDIT_MONITOR=
LEADGEN_ENABLE_CRAIGSLIST_FSBO=
LEADGEN_ENABLE_CITY_DATA=

# ─── Session Storage ──────────────────────────────────────────────────────────
# Optional. Falls back to in-memory store when not set (not suitable for production).
# Format: redis://user:password@host:port
REDIS_URL=

# ─── Audit Log ────────────────────────────────────────────────────────────────
# Optional. Postgres takes priority; set FILE_AUDIT_LOG for file-based logs.
# Falls back to in-memory when neither is set.
DATABASE_URL=
FILE_AUDIT_LOG=false

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Required for the agent dashboard login. Generate a strong secret:
# openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://dynastyrealestate.com

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dynastyrealestate.com
NEXT_PUBLIC_AGENT_NAME=Adreanne
NEXT_PUBLIC_BROKERAGE_NAME=Dynasty Real Estate
